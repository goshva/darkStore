{
  "manifest_version": 3,
  "name": "DarkStore Superset Bridge",
  "version": "0.1.0",
  "description": "Тянет фактические данные даркстора из Superset ВкусВилл (авторизация прямо со страницы) и переносит их в darkStoreBB или сохраняет JSON.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://superset.svc.vkusvill.ru/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://superset.svc.vkusvill.ru/*"],
      "js": ["superset-core.js", "inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
